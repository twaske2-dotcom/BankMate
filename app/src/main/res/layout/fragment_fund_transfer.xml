<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:elevation="4dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/service_fund_transfer"
        android:textColor="@color/dark_gray"
        android:textSize="16sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="18dp"
        android:background="@color/light_gray" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilBeneficiaryName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/navy_primary"
        app:hintTextColor="@color/navy_primary"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconTint="@color/navy_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etBeneficiaryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/beneficiary_name_hint"
            android:inputType="textPersonName"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAccountNumber"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/navy_primary"
        app:hintTextColor="@color/navy_primary"
        app:startIconDrawable="@drawable/ic_account_details"
        app:startIconTint="@color/navy_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAccountNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/beneficiary_account_hint"
            android:inputType="number"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAmount"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="@color/navy_primary"
        app:hintTextColor="@color/navy_primary"
        app:startIconDrawable="@drawable/ic_wallet"
        app:startIconTint="@color/navy_primary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/transfer_amount_hint"
            android:inputType="numberDecimal"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/transfer_mode_label"
        android:textColor="@color/dark_gray"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgTransferMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbImps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/navy_primary"
            android:text="IMPS"
            android:textColor="@color/dark_gray" />

        <RadioButton
            android:id="@+id/rbNeft"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/navy_primary"
            android:text="NEFT"
            android:textColor="@color/dark_gray" />

        <RadioButton
            android:id="@+id/rbUpi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/navy_primary"
            android:text="UPI"
            android:textColor="@color/dark_gray" />
    </RadioGroup>

    <Button
        android:id="@+id/btnConfirmTransfer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@drawable/bg_button_primary"
        android:elevation="0dp"
        android:letterSpacing="0.05"
        android:text="@string/confirm_transfer"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
